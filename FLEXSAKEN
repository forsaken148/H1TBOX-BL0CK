--[[
    FLEX SAKEN - HITBOX PATCH (FIXED)

    PART 1: In your script, DELETE everything from the line
              local BlockWatchers = {}
            down to (and including) the end of
              local function TriggerBlockWithHitbox(...) ... end
            and paste PART 1 in its place.
            Leave WatchKiller / SetAutoBlock exactly as they are.

    PART 2: Paste PART 2 right after the ESP block (the `do ... end` that
            ends with the Gear ESP "Force Rescan" button), before
            "-- MISC FEATURES".
]]

-- ═══════════════════════════════════════════════════════════════
-- PART 1: HITBOX CORE (replaces old block)
-- ═══════════════════════════════════════════════════════════════
local BlockWatchers = {}

-- FIX 1: Clean up any old folder from a previous inject before creating a new one
local _oldFolder = workspace:FindFirstChild("FlexSakenHitboxes")
if _oldFolder then _oldFolder:Destroy() end
local HitboxFolder = Instance.new("Folder")
HitboxFolder.Name = "FlexSakenHitboxes"
HitboxFolder.Parent = workspace

-- Defaults (match the old hard-coded box: 5.2 x 6 x 5.65, offset 0,0,-3.5, x2.2)
local HBDefaults = {
    HitboxSizeX = 5.2, HitboxSizeY = 6, HitboxSizeZ = 5.65,
    HitboxOffX = 0, HitboxOffY = 0, HitboxOffZ = -3.5,
    HitboxScale = 2.2, HitboxWindow = 200,
}
local function HB(key)
    -- FIX 2: Guard State being nil entirely
    local v = (State ~= nil) and State[key] or nil
    if type(v) ~= "number" then v = HBDefaults[key] end
    return v
end

local function GetHitboxSize()
    return Vector3.new(
        math.max(0.1, HB("HitboxSizeX")),
        math.max(0.1, HB("HitboxSizeY")),
        math.max(0.1, HB("HitboxSizeZ"))
    ) * HB("HitboxScale")
end

local function GetHitboxCFrame(QueryHitbox)
    return QueryHitbox.CFrame * CFrame.new(HB("HitboxOffX"), HB("HitboxOffY"), HB("HitboxOffZ"))
end

local function GetLocalQueryHitbox()
    if not LocalCharacter then return nil end
    return LocalCharacter:FindFirstChild("QueryHitbox")
end

-- FIX 3: Added explicit nil+validity guard on QueryHitbox
local function IsInsideKillerHitbox(QueryHitbox)
    if not QueryHitbox or not QueryHitbox.Parent then return false end
    local LocalQuery = GetLocalQueryHitbox()
    if not LocalQuery or not LocalQuery.Parent then return false end

    local Params = OverlapParams.new()
    Params.MaxParts = 1
    Params.BruteForceAllSlow = true
    Params.FilterType = Enum.RaycastFilterType.Include
    Params.FilterDescendantsInstances = { LocalQuery }

    -- FIX 4: pcall now always returns a clean boolean, no silent swallow
    local ok, result = pcall(function()
        return workspace:GetPartBoundsInBox(GetHitboxCFrame(QueryHitbox), GetHitboxSize(), Params)
    end)
    if not ok or type(result) ~= "table" then return false end
    return #result > 0
end

local function TriggerBlockWithHitbox(Killer, QueryHitbox)
    -- FIX 5: Guard State and DoBlock being nil
    if not State then return end
    if not State.AutoBlock or not LocalRoot then return end
    if type(DoBlock) ~= "function" then return end

    if not State.HitboxEnabled then
        DoBlock(QueryHitbox)
        return
    end

    if not GetLocalQueryHitbox() then return end
    local Start = os.clock()
    -- FIX 6: Use HB() so it respects the slider value properly
    local Window = math.max(0.05, HB("HitboxWindow") / 1000)
    while os.clock() - Start < Window do
        -- Re-check AutoBlock each iteration in case user toggled it off mid-swing
        if not State.AutoBlock or not QueryHitbox or not QueryHitbox.Parent then break end
        if IsInsideKillerHitbox(QueryHitbox) then
            DoBlock(QueryHitbox)
            break
        end
        task.wait(0.02)
    end
end

-- Hitbox visualizer
local HitboxVisuals = {}

-- FIX 7: GetVisual checks Parent AND that the part isn't destroyed
local function GetVisual(Killer)
    local V = HitboxVisuals[Killer]
    if V and V.Parent and not V.Parent.Parent == nil then
        -- still valid
    else
        V = Instance.new("Part")
        V.Name = "FlexHitboxVisual"
        V.Anchored = true
        V.CanCollide = false
        V.CanQuery = false
        V.CanTouch = false
        V.CastShadow = false
        V.Material = Enum.Material.Neon
        V.Transparency = 0.75
        V.Color = Color3.fromRGB(220, 20, 60)
        V.Parent = HitboxFolder
        HitboxVisuals[Killer] = V
    end
    return V
end

-- FIX 8: ClearVisuals collects keys first to avoid modifying table mid-iteration
local function ClearVisuals()
    local keys = {}
    for k in pairs(HitboxVisuals) do keys[#keys+1] = k end
    for _, k in ipairs(keys) do
        pcall(function() HitboxVisuals[k]:Destroy() end)
        HitboxVisuals[k] = nil
    end
end

RunService.Heartbeat:Connect(function()
    if not State or not State.ShowHitbox then
        if next(HitboxVisuals) then ClearVisuals() end
        return
    end
    -- FIX 9: Guard KillersFolder being nil before calling GetChildren
    if not KillersFolder then
        if next(HitboxVisuals) then ClearVisuals() end
        return
    end

    local seen = {}
    for _, Killer in ipairs(KillersFolder:GetChildren()) do
        local QH = Killer:FindFirstChild("QueryHitbox")
        if QH and QH:IsA("BasePart") then
            seen[Killer] = true
            local V = GetVisual(Killer)
            V.Size = GetHitboxSize()
            V.CFrame = GetHitboxCFrame(QH)
            V.Color = IsInsideKillerHitbox(QH)
                and Color3.fromRGB(0, 255, 0)
                or  Color3.fromRGB(220, 20, 60)
        end
    end

    -- Clean up visuals for killers that are gone
    local deadKeys = {}
    for Killer in pairs(HitboxVisuals) do
        if not seen[Killer] then deadKeys[#deadKeys+1] = Killer end
    end
    for _, Killer in ipairs(deadKeys) do
        pcall(function() HitboxVisuals[Killer]:Destroy() end)
        HitboxVisuals[Killer] = nil
    end
end)

-- ═══════════════════════════════════════════════════════════════
-- PART 2: HITBOX TAB
-- ═══════════════════════════════════════════════════════════════
do
    local tabHB = Window:Tab({ Title = "Hitbox", Icon = "box" })

    AddSection(tabHB, "Hitbox")
    AddToggle(tabHB, "HitboxEnabled", "Enable Hitbox (Auto Block only inside it)", false)

    AddSection(tabHB, "Visual")
    AddToggle(tabHB, "ShowHitbox", "Show Hitbox (green = you're inside)", false)

    AddSection(tabHB, "Size")
    AddSlider(tabHB, "HitboxSizeX", "Width (X)",   1, 20, 5.2,  0.1)
    AddSlider(tabHB, "HitboxSizeY", "Height (Y)",  1, 20, 6,    0.1)
    AddSlider(tabHB, "HitboxSizeZ", "Length (Z)",  1, 20, 5.65, 0.1)
    AddSlider(tabHB, "HitboxScale", "Size Multiplier", 0.5, 5, 2.2, 0.1)

    AddSection(tabHB, "Offset (relative to killer's facing)")
    AddSlider(tabHB, "HitboxOffX", "Offset X (left/right)",       -15, 15, 0,    0.1)
    AddSlider(tabHB, "HitboxOffY", "Offset Y (up/down)",          -15, 15, 0,    0.1)
    AddSlider(tabHB, "HitboxOffZ", "Offset Z (forward=negative)", -20, 20, -3.5, 0.1)

    AddSection(tabHB, "Auto Block Link")
    AddSlider(tabHB, "HitboxWindow", "Check Window (ms)", 50, 600, 200, 10)

    -- FIX 10: Reset now also resets HitboxEnabled and ShowHitbox toggles
    AddButton(tabHB, "Reset Hitbox To Default", function()
        local defaults = {
            HitboxSizeX = 5.2, HitboxSizeY = 6, HitboxSizeZ = 5.65,
            HitboxScale = 2.2, HitboxOffX = 0, HitboxOffY = 0, HitboxOffZ = -3.5,
            HitboxWindow = 200,
            HitboxEnabled = false,
            ShowHitbox = false,
        }
        for key, val in pairs(defaults) do
            State[key] = val
            if Saved then Saved[key] = val end
            local R = Registry and Registry[key]
            if R and R.Element and R.Element.Set then
                pcall(function() R.Element:Set(val) end)
            end
        end
        if type(SaveSettings) == "function" then SaveSettings() end
    end)
end
