}
local NS_DEFAULT_HITBOX = { dura = 0.26, life = 0.26 }

local function NS_getKillerHitbox(killerName)
    if not killerName then return NS_DEFAULT_HITBOX end
    for name, val in pairs(NS_KILLER_HITBOX) do
        if string.find(killerName, name, 1, true) then return val end
    end
    return NS_DEFAULT_HITBOX
end

local function NS_fireBlock()
    if not Remote then return end
    pcall(function()
        Remote:FireServer(unpack({"UseActorAbility", {buffer.fromstring("\003\005\000\000\000Block")}}))
    end)
end

local function NS_makeHitboxAndCheck(killerModel)
    if not killerModel or not killerModel.Parent then return end
    local killerRoot = killerModel:FindFirstChild("HumanoidRootPart") or killerModel:FindFirstChild("RootPart")
    if not killerRoot then return end
    local hbCfg = NS_getKillerHitbox(killerModel.Name)
    local m = NS_CONFIG.HitboxMultiplier or 1
    local hbWidth  = hbCfg.width  or NS_CONFIG.HitboxWidth
    local hbLength = hbCfg.length or NS_CONFIG.HitboxLength
    local hbHeight = hbCfg.height or NS_CONFIG.HitboxHeight
    local size = Vector3.new(hbWidth * m, hbHeight * m, hbLength * m)
    local op = OverlapParams.new()
    op.FilterType = Enum.RaycastFilterType.Exclude
    op.FilterDescendantsInstances = { killerModel }
    task.spawn(function()
        local startTime = tick()
        local blockedOnce = false
        while tick() - startTime < hbCfg.dura do
            if blockedOnce then break end
            local ckr = killerModel:FindFirstChild("HumanoidRootPart") or killerModel:FindFirstChild("RootPart")
            if not ckr then break end
            local frozenCFrame = ckr.CFrame * CFrame.new(0, 0, -(hbCfg.distance or NS_CONFIG.HitboxDistance or 3))
            local hb = Instance.new("Part")
            hb.Name = "NSHitbox_Frame"
            hb.Transparency = NS_CONFIG.ShowHitboxVisual and NS_CONFIG.HitboxTransparency or 1
            hb.CanCollide = false; hb.CanTouch = false; hb.CanQuery = false
            hb.CastShadow = false; hb.Anchored = true
            hb.Size = size; hb.Color = NS_CONFIG.HitboxColor
            hb.Material = Enum.Material.ForceField
            hb.CFrame = frozenCFrame; hb.Parent = workspace
            local sb
            if NS_CONFIG.ShowOutline and NS_CONFIG.ShowHitboxVisual then
                sb = Instance.new("SelectionBox")
                sb.Adornee = hb; sb.Color3 = NS_CONFIG.HitboxColor
                sb.LineThickness = NS_CONFIG.OutlineThickness
                sb.Transparency = NS_CONFIG.OutlineTransparency
                sb.Visible = true; sb.Parent = hb
            end
            Debris:AddItem(hb, hbCfg.life)
            local found = false
            for _, part in ipairs(workspace:GetPartsInPart(hb, op)) do
                local hum = part.Parent and part.Parent:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 and Players:GetPlayerFromCharacter(hum.Parent) == LocalPlayer then
                    found = true; break
                end
            end
            if found and not blockedOnce then
                blockedOnce = true
                pcall(function()
                    hb.Color = NS_CONFIG.HitboxHitColor
                    if sb then sb.Color3 = NS_CONFIG.HitboxHitColor end
                end)
                NS_fireBlock()
                break
            end
            RunService.Heartbeat:Wait()
        end
    end)
end

-- Sound + anim hooking (NIGHTSAKEN system)
local NS_seen    = {}
local NS_hooked  = {}
local NS_active  = false

-- Sound IDs (same full combined table, used by NS system too)
local NS_soundIDs = AttackSounds

-- Anim IDs for NS system (same full combined table)
local NS_animIDs = AttackAnimations

local function NS_isMe(m)
    return m and (Players:GetPlayerFromCharacter(m) == LocalPlayer or m.Name == LocalPlayer.Name)
end

local function NS_trigger(model)
    if not NS_active or not NS_CONFIG.AutoBlock then return end
    if not model or not model.Parent or NS_isMe(model) then return end
    if NS_seen[model] and os.clock() < NS_seen[model] then return end
    NS_seen[model] = os.clock() + 0.05
    NS_makeHitboxAndCheck(model)
end

local function NS_hookSound(snd, model)
    if not snd or not snd:IsA("Sound") or NS_hooked[snd] then return end
    NS_hooked[snd] = true
    snd.Played:Connect(function()
        if not NS_active or not NS_CONFIG.AutoBlock then return end
        if not NS_soundIDs[snd.SoundId] then return end
        local m = model or snd:FindFirstAncestorOfClass("Model")
        NS_trigger(m)
    end)
end

local function NS_hookAnim(model)
    if not model or NS_isMe(model) then return end
    task.spawn(function()
        local hum = model:WaitForChild("Humanoid", 5); if not hum then return end
        local an = hum:FindFirstChildOfClass("Animator") or hum
        an.AnimationPlayed:Connect(function(tr)
            if not NS_active or not NS_CONFIG.AutoBlock or not tr.Animation then return end
            if not NS_animIDs[tr.Animation.AnimationId] then return end
            NS_trigger(model)
        end)
    end)
end

local function NS_hookModel(m)
    if not m or not m:IsA("Model") or NS_isMe(m) then return end
    for _, d in ipairs(m:GetDescendants()) do
        if d:IsA("Sound") then pcall(NS_hookSound, d, m) end
    end
    m.DescendantAdded:Connect(function(d)
        if d:IsA("Sound") and not NS_isMe(m) then pcall(NS_hookSound, d, m) end
    end)
    NS_hookAnim(m)
end

local NS_killerAddedConn
local function NS_start()
    if NS_active then return end
    NS_active = true
    if not KillersFolder then return end
    for _, c in ipairs(KillersFolder:GetChildren()) do
        if c:IsA("Model") then pcall(NS_hookModel, c) end
    end
    if not NS_killerAddedConn then
        NS_killerAddedConn = KillersFolder.ChildAdded:Connect(function(c)
            if c:IsA("Model") then pcall(NS_hookModel, c) end
        end)
    end
end

local function NS_stop()
    NS_active = false
    table.clear(NS_seen)
    if NS_killerAddedConn then NS_killerAddedConn:Disconnect(); NS_killerAddedConn = nil end
end

local function SetNSAutoBlock(on)
    NS_CONFIG.AutoBlock = on
    if on then NS_start() else NS_stop() end
end

