            else if gearESP.current then gearCleanup() end end
        end
        local function startGearESP()
            if gearESP.enabled then return end; gearESP.enabled = true
            if gearESP.conn then pcall(function() gearESP.conn:Disconnect() end) end
            gearESP.conn = RunService.Heartbeat:Connect(checkGear); checkGear()
        end
