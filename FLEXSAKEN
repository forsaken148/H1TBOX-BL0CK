    local espColors = {
        killer = Color3.fromRGB(255, 50, 50), survivor = Color3.fromRGB(50, 255, 50),
        generator = Color3.fromRGB(255, 200, 50), item = Color3.fromRGB(50, 200, 255),
        structure = Color3.fromRGB(255, 150, 50),
    }

    local genLabels = {}; local genConns = {}

    local function readProg(obj)
        if not obj or not obj.Parent then return 0 end
        local pv = obj:FindFirstChild("Progress")
        if pv and (pv:IsA("NumberValue") or pv:IsA("IntValue")) then return pv.Value end
        local av = obj:GetAttribute("Progress") or obj:GetAttribute("Charge")
        if type(av) == "number" then return av end
        return 0
    end

    local function fmtGen(progress)
        local pct = math.floor(progress)
        local col = (pct >= 100) and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(255, 200, 50)
        return string.format("Generator | %d%%", pct), col
    end

    local function cleanGen(obj)
        if genConns[obj] then
            for _, c in ipairs(genConns[obj]) do pcall(function() c:Disconnect() end) end
            genConns[obj] = nil
        end
        genLabels[obj] = nil
    end

    local function refreshGen(obj)
        if not obj or not obj.Parent then return end
        local progress = readProg(obj)
        if progress >= 100 then
            if esp.highlights[obj] then pcall(function() esp.highlights[obj]:Destroy() end) esp.highlights[obj] = nil end
            if esp.billboards[obj] then pcall(function() esp.billboards[obj]:Destroy() end) esp.billboards[obj] = nil end
            cleanGen(obj); return
        end
        local label = genLabels[obj]
        if not label then
            local bb = obj:FindFirstChildWhichIsA("BillboardGui")
            if bb then label = bb:FindFirstChildWhichIsA("TextLabel") end
            if label then genLabels[obj] = label else return end
        end
        if not label.Parent then genLabels[obj] = nil; return end
        local txt, col = fmtGen(progress)
        label.Text = txt; label.TextColor3 = col; label.TextSize = 10
        label.Font = Enum.Font.Code; label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        label.TextStrokeTransparency = 0.5; label.Visible = true
    end

    local function watchGen(obj)
        if not obj then return end
        if genConns[obj] then for _, c in ipairs(genConns[obj]) do pcall(function() c:Disconnect() end) end; genConns[obj] = nil end
        local conns = {}
        local pv = obj:FindFirstChild("Progress")
        if pv and (pv:IsA("NumberValue") or pv:IsA("IntValue")) then
            table.insert(conns, pv:GetPropertyChangedSignal("Value"):Connect(function() pcall(refreshGen, obj) end))
        end
        table.insert(conns, obj.ChildAdded:Connect(function(c)
            if c.Name == "Progress" and (c:IsA("NumberValue") or c:IsA("IntValue")) then
                table.insert(conns, c:GetPropertyChangedSignal("Value"):Connect(function() pcall(refreshGen, obj) end))
                pcall(refreshGen, obj)
            end
        end))
        table.insert(conns, obj.AttributeChanged:Connect(function(a)
            if a == "Progress" or a == "Charge" then pcall(refreshGen, obj) end
        end))
        genConns[obj] = conns; pcall(refreshGen, obj)
    end

    local function setupGen(obj, label)
        if not obj or not label then return end
        genLabels[obj] = label
        local bb = label.Parent
        if bb and bb:IsA("BillboardGui") then
            bb.Enabled = true; bb.AlwaysOnTop = true
            bb.Size = UDim2.new(0, 160, 0, 18); bb.StudsOffset = Vector3.new(0, 4, 0)
        end
        local txt, col = fmtGen(readProg(obj))
        label.Text = txt; label.TextColor3 = col; label.TextSize = 10
        label.Font = Enum.Font.Code; label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        label.TextStrokeTransparency = 0.5; label.Visible = true
        watchGen(obj)
    end

    local function wipeGens()
        for obj in pairs(genConns) do
            for _, c in ipairs(genConns[obj]) do pcall(function() c:Disconnect() end) end
        end
        genLabels = {}; genConns = {}
    end

    local function makeHl(obj, color)
        if not obj or not obj.Parent then return nil end
        local folder = getUIFolder(); if not folder then return nil end
        local hl = Instance.new("Highlight")
        hl.Name = "V1PR_Highlight"; hl.FillColor = color; hl.FillTransparency = esp.transparency
        hl.OutlineColor = color; hl.OutlineTransparency = 0.1
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop; hl.Adornee = obj
        pcall(function() hl.Parent = folder end); return hl
    end

    local function isDup(obj)
        local p = obj and obj.Parent
        while p and p ~= svc.WS do
            if esp.highlights[p] then return true end; p = p.Parent
        end
        return false
    end

    local function wipeESP()
        for _, hl in pairs(esp.highlights) do pcall(function() hl:Destroy() end) end; esp.highlights = {}
        for _, bb in pairs(esp.billboards) do pcall(function() bb:Destroy() end) end; esp.billboards = {}
        for _, c in pairs(esp.healthConnections) do pcall(function() c:Disconnect() end) end; esp.healthConnections = {}
        for _, c in ipairs(esp.connections) do pcall(function() c:Disconnect() end) end; esp.connections = {}
        esp.labelCache = {}; wipeGens()
    end

    local function addTarget(obj, color, labelText, isChar)
        if not obj or not obj.Parent then return end
        if esp.highlights[obj] and esp.highlights[obj].Parent then return end
        if esp.highlights[obj] then pcall(function() esp.highlights[obj]:Destroy() end); esp.highlights[obj] = nil end
        if isDup(obj) then return end
        local attach = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso") or obj:FindFirstChildWhichIsA("BasePart") or obj:FindFirstChildOfClass("BasePart")
        if not attach then return end
        local hl = makeHl(obj, color); if not hl then return end
        local bb = Instance.new("BillboardGui")
        bb.Adornee = attach; bb.Size = UDim2.new(0, 140, 0, 18); bb.StudsOffset = Vector3.new(0, 4, 0)
        bb.AlwaysOnTop = true; bb.MaxDistance = esp.maxDistance; bb.Parent = obj
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0); label.BackgroundTransparency = 1
        if isChar then
            local plr = svc.Players:GetPlayerFromCharacter(obj)
            local uname = plr and plr.Name or obj.Name
            label.Text = uname .. " | " .. obj.Name
        else label.Text = labelText or obj.Name end
        label.TextColor3 = color; label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        label.TextStrokeTransparency = 0.5; label.TextSize = 10; label.Font = Enum.Font.Code; label.Parent = bb
        esp.highlights[obj] = hl; esp.billboards[obj] = bb
        if labelText == "Generator" or (not isChar and obj.Name == "Generator") then
            if readProg(obj) >= 100 then
                pcall(function() hl:Destroy() end); pcall(function() bb:Destroy() end)
                esp.highlights[obj] = nil; esp.billboards[obj] = nil; return
            end
            setupGen(obj, label)
        end
        if isChar then
            local plr = svc.Players:GetPlayerFromCharacter(obj)
            esp.labelCache[obj] = {
                label = label, uname = plr and plr.Name or obj.Name,
                cname = obj.Name, hum = obj:FindFirstChildOfClass("Humanoid"), lastH = -1,
            }
            local anc
            anc = obj.AncestryChanged:Connect(function()
                if obj.Parent then return end
                if esp.highlights[obj] then pcall(function() esp.highlights[obj]:Destroy() end) end
                if esp.billboards[obj] then pcall(function() esp.billboards[obj]:Destroy() end) end
                if esp.healthConnections[obj] then pcall(function() esp.healthConnections[obj]:Disconnect() end) end
                cleanGen(obj)
                esp.highlights[obj] = nil; esp.billboards[obj] = nil
                esp.healthConnections[obj] = nil; esp.labelCache[obj] = nil
                pcall(function() anc:Disconnect() end)
            end)
        end
    end

    local function refreshLabel(obj, data)
        local hum, label = data.hum, data.label
        if not obj.Parent or not hum or not hum.Parent or not label or not label.Parent then
            esp.labelCache[obj] = nil; return
        end
        if hum.Health > 0 then
            local hR = math.floor(hum.Health)
            if hR ~= data.lastH then data.lastH = hR; label.Text = data.uname .. " | " .. data.cname .. " | " .. hR .. "Hp" end
        else
            if esp.highlights[obj] then pcall(function() esp.highlights[obj]:Destroy() end) esp.highlights[obj] = nil end
            if esp.billboards[obj] then pcall(function() esp.billboards[obj]:Destroy() end) esp.billboards[obj] = nil end
            if esp.healthConnections[obj] then pcall(function() esp.healthConnections[obj]:Disconnect() end) esp.healthConnections[obj] = nil end
            esp.labelCache[obj] = nil
        end
    end

    local function labelLoop()
        if esp.labelThread then return end
        esp.labelThread = svc.Run.Heartbeat:Connect(function()
            if not esp.enabled then return end
            for obj, data in pairs(esp.labelCache) do refreshLabel(obj, data) end
        end)
    end
    local function stopLabels()
        if esp.labelThread then esp.labelThread:Disconnect(); esp.labelThread = nil end
    end

    local function pollTeams()
        if not esp.enabled or not lp then return end
        local myChar = lp.Character
        local dead = {}
        for obj in pairs(esp.highlights) do if not obj or not obj.Parent then table.insert(dead, obj) end end
        for _, obj in ipairs(dead) do
            if esp.highlights[obj] then pcall(function() esp.highlights[obj]:Destroy() end) end
            if esp.billboards[obj] then pcall(function() esp.billboards[obj]:Destroy() end) end
            if esp.healthConnections[obj] then pcall(function() esp.healthConnections[obj]:Disconnect() end) end
            cleanGen(obj)
            esp.highlights[obj] = nil; esp.billboards[obj] = nil; esp.healthConnections[obj] = nil; esp.labelCache[obj] = nil
        end
        local function addPlayer(obj, color, label)
            if not obj or not obj.Parent or esp.highlights[obj] then return end
            if obj == myChar then return end
            local h = obj:FindFirstChildOfClass("Humanoid")
            if not h or h.Health <= 0 then return end
            addTarget(obj, color, label, true)
        end
        if esp.showKillers then
            local kf = getTeam("Killers")
            if kf then for _, m in ipairs(kf:GetChildren()) do if m:IsA("Model") then addPlayer(m, espColors.killer, m.Name) end end end
        end
        if esp.showSurvivors then
            local sf = getTeam("Survivors")
            if sf then for _, m in ipairs(sf:GetChildren()) do if m:IsA("Model") then addPlayer(m, espColors.survivor, m.Name) end end end
        end
        if esp.showGenerators then
            local mc = mapContent() or ingameFolder()
            if mc then
                for _, o in ipairs(mc:GetChildren()) do
                    if o.Name == "Generator" and o.Parent and not esp.highlights[o] then
                        if readProg(o) < 100 then addTarget(o, espColors.generator, "Generator") end
                    end
                end
            end
        end
    end

    local function isItemName(n) return n == "BloxyCola" or n == "Medkit" end

    local function hookItems()
        if esp._itemHook then return end
        esp._itemHook = svc.WS.DescendantAdded:Connect(function(o)
            if not esp.enabled or not esp.showItems or not isItemName(o.Name) then return end
            task.defer(function()
                if esp.enabled and o.Parent and not esp.highlights[o] then addTarget(o, espColors.item, o.Name) end
            end)
        end)
    end
    local function unhookItems()
        if esp._itemHook then pcall(function() esp._itemHook:Disconnect() end) esp._itemHook = nil end
    end

    local function scanItems()
        task.spawn(function()
            local root = svc.WS; local stack = { root }; local steps = 0
            while #stack > 0 and esp.enabled and esp.showItems do
                local cur = table.remove(stack)
                for _, c in ipairs(cur:GetChildren()) do
                    local nm = c.Name
                    if isItemName(nm) then
                        if not esp.highlights[c] then pcall(addTarget, c, espColors.item, nm) end
                    elseif not c:IsA("BasePart") and not (cur == root and (nm == "Players" or c:IsA("Terrain") or c:IsA("Camera"))) then
                        table.insert(stack, c)
                    end
                    steps += 1; if steps % 300 == 0 then task.wait() end
                end
            end
        end)
    end

    local function bindIngame()
        if not lp then return end
        local function removeObj(obj)
            if esp.highlights[obj] then pcall(function() esp.highlights[obj]:Destroy() end) end
            if esp.billboards[obj] then pcall(function() esp.billboards[obj]:Destroy() end) end
            if esp.healthConnections[obj] then pcall(function() esp.healthConnections[obj]:Disconnect() end) end
            cleanGen(obj)
            esp.highlights[obj] = nil; esp.billboards[obj] = nil; esp.healthConnections[obj] = nil; esp.labelCache[obj] = nil
        end
        local ig = ingameFolder(); if not ig then return end
        table.insert(esp.connections, ig.DescendantAdded:Connect(function(o)
            if not esp.enabled then return end
            if o.Name == "Generator" and esp.showGenerators then
                task.defer(function()
                    if esp.enabled and o.Parent and not esp.highlights[o] and readProg(o) < 100 then
                        addTarget(o, espColors.generator, "Generator")
                    end
                end)
            elseif esp.showStructures and (o.Name == "BuildermanSentry" or o.Name == "SubspaceTripmine" or o.Name == "BuildermanDispenser") then
                task.defer(function()
                    if esp.enabled and o.Parent and not esp.highlights[o] then
                        local tag = (o.Name == "BuildermanSentry" and "Sentry") or (o.Name == "BuildermanDispenser" and "Dispenser") or (o.Name == "SubspaceTripmine" and "Tripmine") or o.Name
                        addTarget(o, espColors.structure, tag)
                    end
                end)
            end
        end))
        table.insert(esp.connections, ig.DescendantRemoving:Connect(function(o)
            if not (esp.highlights[o] or esp.billboards[o]) then return end
            task.delay(0.5, function() if o and o.Parent then return end; removeObj(o) end)
        end))
    end

    local function startESP()
        wipeESP(); esp.enabled = true; labelLoop(); pcall(bindIngame); pcall(hookItems); pcall(pollTeams)
        if esp.showItems then scanItems() end
        task.defer(function()
            if not esp.enabled then return end
            local ig = ingameFolder(); if not ig then return end
            for _, o in ipairs(ig:GetDescendants()) do
                if not esp.enabled then return end
                if o.Name == "Generator" and esp.showGenerators then
                    if not esp.highlights[o] and readProg(o) < 100 then addTarget(o, espColors.generator, "Generator") end
                elseif esp.showStructures and (o.Name == "BuildermanSentry" or o.Name == "SubspaceTripmine" or o.Name == "BuildermanDispenser") then
                    if not esp.highlights[o] then
                        local tag = (o.Name == "BuildermanSentry" and "Sentry") or (o.Name == "BuildermanDispenser" and "Dispenser") or (o.Name == "SubspaceTripmine" and "Tripmine") or o.Name
                        addTarget(o, espColors.structure, tag)
                    end
                end
            end
        end)
        if esp.scanThread then task.cancel(esp.scanThread) end
        esp.scanThread = task.spawn(function()
            while esp.enabled do pcall(pollTeams); task.wait(esp.scanRate) end
            esp.scanThread = nil
        end)
    end

    local function stopESP()
        esp.enabled = false; unhookItems()
        if esp.scanThread then task.cancel(esp.scanThread) end
        esp.scanThread = nil; stopLabels(); wipeESP()
    end

    if not esp._mapWatch then
        esp._mapWatch = true
        onIngameAdded(function()
            if not esp.enabled then return end
            task.wait(1.5); if esp.enabled then pcall(startESP) end
        end)
    end

    -- Plants
    local plantOpts = { groundbulb = true, vine = true, hlColor = Color3.fromRGB(170, 0, 255), fillAlpha = 0.4, lineAlpha = 0.1 }
    local plant = { enabled = false, tracked = {}, objects = {}, addConn = nil, rmConn = nil, watchConn = nil }

    local function topPart(model)
        local best = model.PrimaryPart; local y = best and best.Position.Y or -math.huge
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("BasePart") then
                if d.Name:find("Flower") or d.Position.Y > y then y = d.Position.Y; best = d end
            end
        end
        return best
    end

    local function markPlant(model, displayName)
        if not model or not model:IsA("Model") then return end
        if plant.tracked[model] then return end
        for _, child in ipairs(model:GetChildren()) do if child:IsA("Highlight") then child:Destroy() end end
        local oldHl = model:FindFirstChild("GvHighlight"); if oldHl then oldHl:Destroy() end
        local oldBb = model:FindFirstChild("GvTag"); if oldBb then oldBb:Destroy() end
        local attach = topPart(model)
        if not attach then for _, d in ipairs(model:GetDescendants()) do if d:IsA("BasePart") and d.Name ~= "Handle" then attach = d break end end end
        if not attach then return end
        if not model.PrimaryPart then model.PrimaryPart = attach end
        local hl = Instance.new("Highlight"); hl.Name = "GvHighlight"; hl.Adornee = model
        hl.FillColor = plantOpts.hlColor; hl.FillTransparency = plantOpts.fillAlpha
        hl.OutlineColor = plantOpts.hlColor; hl.OutlineTransparency = plantOpts.lineAlpha
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop; hl.Enabled = true; hl.Parent = model
        local bb = Instance.new("BillboardGui"); bb.Name = "GvTag"; bb.Size = UDim2.new(0, 160, 0, 22)
        bb.Adornee = attach; bb.StudsOffset = Vector3.new(0, 0.5, 0); bb.MaxDistance = 150
        bb.AlwaysOnTop = true; bb.Parent = model
        local lbl = Instance.new("TextLabel"); lbl.Name = "Label"; lbl.Size = UDim2.new(1, 0, 1, 0)
        lbl.BackgroundTransparency = 1; lbl.Text = displayName; lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
        lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0); lbl.TextStrokeTransparency = 0.5
        lbl.Font = Enum.Font.Code; lbl.TextSize = 11; lbl.Parent = bb
        plant.tracked[model] = true; plant.objects[model] = { highlight = hl, billboard = bb }
    end

    local function checkPlant(child)
        if not child:IsA("Model") then return end
        local n = child.Name:lower()
        if n == "groundbulbmodel" then if plantOpts.groundbulb and not plant.tracked[child] then markPlant(child, "GroundBulb") end
        elseif n == "vinemodel" then if plantOpts.vine and not plant.tracked[child] then markPlant(child, "Vine") end end
    end

    local function clearPlant(model)
        if plant.objects[model] then
            if plant.objects[model].highlight then pcall(function() plant.objects[model].highlight:Destroy() end) end
            if plant.objects[model].billboard then pcall(function() plant.objects[model].billboard:Destroy() end) end
            plant.objects[model] = nil
        end
        plant.tracked[model] = nil
    end

    local function bindPlants()
        for model in pairs(plant.tracked) do if not model or not model.Parent then clearPlant(model) end end
        local ig = ingameFolder(); if not ig then return false end
        if plant.addConn then plant.addConn:Disconnect(); plant.addConn = nil end
        if plant.rmConn then plant.rmConn:Disconnect(); plant.rmConn = nil end
        for _, obj in ipairs(ig:GetDescendants()) do if obj:IsA("Model") then checkPlant(obj) end end
        plant.addConn = ig.DescendantAdded:Connect(function(child)
            if plant.enabled and child:IsA("Model") then task.defer(function() if plant.enabled and child.Parent then checkPlant(child) end end) end
        end)
        plant.rmConn = ig.DescendantRemoving:Connect(function(child) if plant.tracked[child] then clearPlant(child) end end)
        return true
    end

    local function startPlants()
        if plant.enabled then return end; plant.enabled = true; bindPlants()
        if not plant._mapWatch then
            plant._mapWatch = true
            onIngameAdded(function() if not plant.enabled then return end; task.wait(1); if plant.enabled then bindPlants() end end)
        end
    end
    local function stopPlants()
        plant.enabled = false
        if plant.addConn then plant.addConn:Disconnect(); plant.addConn = nil end
        if plant.rmConn then plant.rmConn:Disconnect(); plant.rmConn = nil end
        if plant.watchConn then plant.watchConn:Disconnect(); plant.watchConn = nil end
        for _, data in pairs(plant.objects) do
            if data.highlight then pcall(function() data.highlight:Destroy() end) end
            if data.billboard then pcall(function() data.billboard:Destroy() end) end
        end
        plant.objects = {}; plant.tracked = {}
    end

    -- Mobs
    local mobOpts = { pizza = false, zombie = false, puddle = false, alpha = 0.25 }
    local mobTrack = { pizza = {}, zombie = {}, puddle = {} }

    local function isPlayer(obj)
        for _, p in ipairs(svc.Players:GetPlayers()) do
            if p.Character == obj or (p.Character and obj:IsDescendantOf(p.Character)) then return true end
        end
        return false
    end

    local function syncMobAlpha()
        for tag, tbl in pairs(mobTrack) do
            for obj in pairs(tbl) do
                local h = obj:FindFirstChild(tag .. "_HL"); if h then h.FillTransparency = mobOpts.alpha end
            end
        end
    end

    local function clearMob(tag)
        for obj in pairs(mobTrack[tag]) do
            local h = obj:FindFirstChild(tag .. "_HL"); if h then h:Destroy() end
            local b = obj:FindFirstChild(tag .. "_BB"); if b then b:Destroy() end
            if tag == "puddle" then local h2 = obj:FindFirstChild("PuddleHolder"); if h2 then h2:Destroy() end end
        end
        mobTrack[tag] = {}
    end

    local function markMob(obj, color, tag, label, offset)
        if not obj or mobTrack[tag][obj] or isPlayer(obj) then return end
        mobTrack[tag][obj] = true
        local root = obj
        if obj:IsA("Model") then
            root = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso") or obj.PrimaryPart
            if not root then for _, c in ipairs(obj:GetChildren()) do if c:IsA("BasePart") then root = c break end end end
        end
        local hl = Instance.new("Highlight"); hl.Name = tag .. "_HL"; hl.FillColor = color
        hl.FillTransparency = mobOpts.alpha; hl.OutlineColor = color; hl.OutlineTransparency = 0.1
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop; hl.Adornee = obj; hl.Parent = obj
        if root then
            local bb = Instance.new("BillboardGui"); bb.Name = tag .. "_BB"; bb.Adornee = root
            bb.Size = UDim2.new(0, 140, 0, 20); bb.StudsOffset = Vector3.new(0, offset or 3, 0)
            bb.AlwaysOnTop = true; bb.Parent = obj
            local lbl = Instance.new("TextLabel"); lbl.Size = UDim2.new(1, 0, 1, 0)
            lbl.BackgroundTransparency = 1; lbl.Text = label; lbl.TextColor3 = color
            lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0); lbl.TextStrokeTransparency = 0.5
            lbl.TextSize = 11; lbl.Font = Enum.Font.Code; lbl.Parent = bb
        end
        obj.AncestryChanged:Connect(function()
            if obj.Parent then return end
            local h2 = obj:FindFirstChild(tag .. "_HL"); if h2 then h2:Destroy() end
            local b2 = obj:FindFirstChild(tag .. "_BB"); if b2 then b2:Destroy() end
            mobTrack[tag][obj] = nil
        end)
    end

    local function markPuddle(part, color, tag, label)
        if not part or mobTrack[tag][part] or isPlayer(part) then return end
        mobTrack[tag][part] = true
