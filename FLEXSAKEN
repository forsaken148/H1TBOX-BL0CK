-- EXECUTOR COMPATIBILITY SHIM
-- Supported PC  : Opiumware, Volcano, Real, Potassium, Volt
-- Supported Mobile: Codex, Delta
-- ═══════════════════════════════════════════════════════════════
do
    -- ── Detect executor ────────────────────────────────────────
    local execName = (
        (typeof(getexecutorname) == "function" and pcall(function() return getexecutorname() end) and (function() local ok, n = pcall(getexecutorname); return ok and n or "" end)()) or
        (typeof(identifyexecutor) == "function" and pcall(function() return identifyexecutor() end) and (function() local ok, n = pcall(identifyexecutor); return ok and n or "" end)()) or
        ""
    ):lower()

    -- ── gethui ─────────────────────────────────────────────────
    -- All 7 executors: fall back to CoreGui if gethui is missing
    if typeof(gethui) ~= "function" then
        gethui = function()
            return game:GetService("CoreGui")
        end
    end

    -- ── File I/O ───────────────────────────────────────────────
    -- Opiumware / Potassium / Volt use standard names (readfile etc.)
    -- Volcano uses the same names but may need a pcall guard (already done in script)
    -- Real uses readfile/writefile but may expose them differently
    -- Codex / Delta: standard names on mobile

    if typeof(readfile) ~= "function" then
        -- Some executors expose these under alternate names
        readfile   = typeof(read_file)   == "function" and read_file   or
                     typeof(io_read)     == "function" and io_read     or
                     function() return nil end
    end
    if typeof(writefile) ~= "function" then
        writefile  = typeof(write_file)  == "function" and write_file  or
                     typeof(io_write)    == "function" and io_write    or
                     function() end
    end
    if typeof(isfile) ~= "function" then
        isfile     = typeof(file_exists) == "function" and file_exists or
                     function() return false end
    end
    if typeof(isfolder) ~= "function" then
        isfolder   = typeof(folder_exists) == "function" and folder_exists or
                     function() return false end
    end
    if typeof(makefolder) ~= "function" then
        makefolder = typeof(create_folder) == "function" and create_folder or
                     typeof(mkdir)        == "function" and mkdir         or
                     function() end
    end
    if typeof(appendfile) ~= "function" then
        appendfile = function(path, data)
            local ok, existing = pcall(readfile, path)
            pcall(writefile, path, (ok and existing or "") .. data)
        end
    end

    -- ── Clipboard ──────────────────────────────────────────────
    -- Opiumware, Volcano, Real, Potassium, Volt: setclipboard
    -- Codex: setclipboard
    -- Delta: setclipboard or toclipboard
    if typeof(setclipboard) ~= "function" then
        setclipboard = typeof(toclipboard)    == "function" and toclipboard    or
                       typeof(set_clipboard)  == "function" and set_clipboard  or
                       function() end
    end
    if typeof(toclipboard) ~= "function" then
        toclipboard = setclipboard
    end

    -- ── HttpGet ────────────────────────────────────────────────
    -- game:HttpGet is used in this script already;
    -- some executors also expose it via syn.request or http.request
    -- Patch game.HttpGet if missing (shouldn't happen but safety net)
    if typeof(game.HttpGet) ~= "function" then
        pcall(function()
            if typeof(syn) == "table" and typeof(syn.request) == "function" then
                game.HttpGet = function(_, url, nocache)
                    local res = syn.request({ Url = url, Method = "GET" })
                    return res and res.Body or ""
                end
            elseif typeof(http) == "table" and typeof(http.request) == "function" then
                game.HttpGet = function(_, url, nocache)
                    local res = http.request({ Url = url, Method = "GET" })
                    return res and res.Body or ""
                end
            elseif typeof(request) == "function" then
                game.HttpGet = function(_, url, nocache)
                    local res = request({ Url = url, Method = "GET" })
                    return res and res.Body or ""
                end
            end
        end)
    end

    -- ── hookfunction ───────────────────────────────────────────
    -- Opiumware: hookfunction ✓
    -- Volcano  : hookfunction ✓
    -- Real     : hookfunction ✓
    -- Potassium: hookfunction ✓
    -- Volt     : hookfunction ✓
    -- Codex    : hookfunction ✓
    -- Delta    : hookfunction ✓  (also exposes replaceclosure)
    if typeof(hookfunction) ~= "function" then
        hookfunction = typeof(replaceclosure) == "function" and replaceclosure or
                       typeof(detour_function) == "function" and detour_function or
                       function(f, r) return f end  -- no-op fallback
    end
    -- replaceclosure alias for scripts that call it directly
    if typeof(replaceclosure) ~= "function" then
        replaceclosure = hookfunction
    end

    -- ── setreadonly ────────────────────────────────────────────
    -- Most executors expose setreadonly; Codex may expose it as
    -- make_writeable or similar. Provide a safe no-op if missing.
    if typeof(setreadonly) ~= "function" then
        setreadonly = typeof(make_writeable) == "function" and function(t, ro)
            if not ro then make_writeable(t) end
        end or function() end
    end

    -- ── debug upvalue functions ────────────────────────────────
    -- Used by Auto Azure QTE feature.
    -- Opiumware, Volcano, Real, Potassium, Volt: debug.getupvalues / debug.setupvalue
    -- Codex / Delta: same (UNC compliant)
    if typeof(debug) == "table" then
        if typeof(debug.getupvalues) ~= "function" then
            debug.getupvalues = typeof(getupvalues) == "function" and getupvalues or function() return {} end
        end
        if typeof(debug.setupvalue) ~= "function" then
            debug.setupvalue = typeof(setupvalue) == "function" and setupvalue or function() end
        end
        if typeof(debug.info) ~= "function" then
            debug.info = typeof(debuginfo) == "function" and debuginfo or function() return 0 end
        end
    end

    -- ── getgenv ────────────────────────────────────────────────
    if typeof(getgenv) ~= "function" then
        getgenv = function() return getfenv(0) end
    end

    -- ── getconnections ─────────────────────────────────────────
    -- Used by AutoTrick and VR_monitorHighlight to fire existing
    -- signal connections.  Provide a safe no-op table if missing.
    if typeof(getconnections) ~= "function" then
        getconnections = function() return {} end
    end

    -- ── VirtualUser anti-idle ──────────────────────────────────
    -- Some executors don't expose VirtualUser; guard it
    pcall(function()
        game:GetService("VirtualUser")
    end)
end

