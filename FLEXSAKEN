local NS_KILLER_HITBOX = {
    ["CoolKid"]   = { dura = 0.05, life = 0.05, width = 5, length = 7, height = 6 },
    ["Slasher"]   = { dura = 0.35, life = 0.35 },
    ["1x1x1x1"]   = { dura = 0.45, life = 0.45 },
