-- Helper: fetch a URL using the best available HTTP primitive.
-- Delta requires request(); game:HttpGet silently returns "" on Delta.
local function _fetchURL(url)
    -- 1) Delta / UNC: request()
    if typeof(request) == "function" then
        local ok, res = pcall(request, { Url = url, Method = "GET" })
        if ok and res then
            local body = res.Body or res.body or ""
            if #body > 500 then return body end
        end
    end
    -- 2) Synapse
    if typeof(syn) == "table" and typeof(syn.request) == "function" then
        local ok, res = pcall(syn.request, { Url = url, Method = "GET" })
        if ok and res then
            local body = res.Body or res.body or ""
            if #body > 500 then return body end
        end
    end
    -- 3) http.request
    if typeof(http) == "table" and typeof(http.request) == "function" then
        local ok, res = pcall(http.request, { Url = url, Method = "GET" })
        if ok and res then
            local body = res.Body or res.body or ""
            if #body > 500 then return body end
        end
    end
    -- 4) Last resort: game:HttpGet (works on most PC executors, may fail on Delta)
    local ok, res = pcall(function() return game:HttpGet(url, true) end)
    if ok and res and #res > 500 then return res end
    return nil
end

local function _tryLoadSource(src)
    if not src or #src < 500 then return nil end
    local ok, result = pcall(function() return loadstring(src)() end)
    if ok and result and type(result) == "table" then return result end
    return nil
end

-- Step 1: try disk cache
pcall(function()
    if isfile and isfile(_cacheFile) then
        local src = readfile(_cacheFile)
        local lib = _tryLoadSource(src)
        if lib then
            WindUI = lib
            warn("[FlexSaken] WindUI loaded from disk cache")
        end
    end
end)

-- Step 2: download from URLs
if not WindUI then
    for attempt = 1, 4 do
        if attempt > 1 then
            warn("[FlexSaken] WindUI attempt " .. attempt .. "/4 — retrying in 3s...")
            task.wait(3)
        end
        for _, url in ipairs(_uiUrls) do
            local src = _fetchURL(url)
            if src then
                local lib = _tryLoadSource(src)
                if lib then
                    WindUI = lib
                    pcall(function()
                        if writefile then writefile(_cacheFile, src) end
                    end)
                    warn("[FlexSaken] WindUI loaded from: " .. url)
                    break
                else
                    warn("[FlexSaken] WindUI downloaded but failed to execute from: " .. url)
                end
            else
                warn("[FlexSaken] WindUI fetch failed for: " .. url)
            end
        end
        if WindUI then break end
    end
end

